# MongoDB Atlas connection string (Rule 19-24)
# - Enable authentication (strong DB user password)
# - TLS/SSL is required (?ssl=true or mongodb+srv://)
# - Restrict IP allowlist in Atlas Network Access
# - Use separate DB user credentials for dev and prod
# - IMPORTANT: Database name (/run01) must be included at the end of the URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/run01?retryWrites=true&w=majority

# JWT Signing Secret (Rule 8, 41)
JWT_SECRET=run01_jwt_secret_key_change_in_production

# Google OAuth 2.0 Client ID (from Google Cloud Console)
# Also add https://run01.vercel.app to "Authorized JavaScript Origins" in Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Flask Session Secret Key — must be stable across deployments (do NOT use the default)
SECRET_KEY=run01_secret_key_change_in_production

# AI Coding Assistant + CAD Studio (OpenAI-compatible providers)
# NVIDIA NIM is preferred; Groq is an automatic fallback. Optional _2 keys are backups.
NVIDIA_API_KEY=your_nvidia_nim_api_key
# NVIDIA_API_KEY_2=
GROQ_API_KEY=your_groq_api_key
# GROQ_API_KEY_2=

# MongoDB Atlas connection string — Set your credentials in Vercel / Environment Variables
# IMPORTANT: Database name (/run01) must be included at the end of the URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/run01?retryWrites=true&w=majority

# Google OAuth 2.0 Client ID (from Google Cloud Console)
# Also add https://run01.vercel.app to "Authorized JavaScript Origins" in Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Flask Session Secret Key — must be stable across deployments (do NOT use the default)
SECRET_KEY=run01_secret_key_change_in_production
